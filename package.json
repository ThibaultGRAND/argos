{
  "name": "argos",
  "productName": "Argos",
  "version": "0.0.1",
  "description": "Poste de pilotage local pour agents de code IA",
  "private": true,
  "license": "MIT",
  "author": "Thibault Grand",
  "homepage": "https://github.com/ThibaultGRAND/argos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThibaultGRAND/argos.git"
  },
  "bugs": {
    "url": "https://github.com/ThibaultGRAND/argos/issues"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mac": "electron-vite build && electron-builder --mac --config config/electron-builder.yml --publish never",
    "build:win": "electron-vite build && electron-builder --win --config config/electron-builder.yml --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --config config/electron-builder.yml --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:architecture": "depcruise src --config config/dependency-cruiser.cjs",
    "db:generate:argos": "drizzle-kit generate --config src/infrastructure/database/argos/drizzle.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:architecture && npm run test",
    "db:generate:index": "drizzle-kit generate --config src/infrastructure/database/index/drizzle.config.ts",
    "icons": "electron config/render-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "@anthropic-ai/sdk": "0.131.0",
    "@intlify/core": "11.4.13",
    "@modelcontextprotocol/sdk": "1.32.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "electron-updater": "6.8.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "dependency-cruiser": "18.5.0",
    "drizzle-kit": "0.31.11",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2",
    "pinia": "4.0.3",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-eslint-parser": "10.4.1",
    "vue-i18n": "11.4.13",
    "vue-router": "5.3.1",
    "vue-tsc": "3.3.12"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.5.1": true,
    "fsevents@2.3.3": true
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "all"
  }
}
